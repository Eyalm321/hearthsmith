#!/usr/bin/env bash
# forge-sprite [start|stop|toggle|status]  — the avatar runs as a user service, never in a terminal.
set -euo pipefail
U=forge-sprite.service
case "${1:-toggle}" in
  start)  systemctl --user start "$U" ;;
  stop)   systemctl --user stop "$U" ;;
  status) systemctl --user status "$U" --no-pager ;;
  toggle) if systemctl --user is-active -q "$U"; then systemctl --user stop "$U"; echo "sprite hidden"
          else systemctl --user start "$U"; echo "sprite shown"; fi ;;
  *) echo "usage: forge-sprite [start|stop|toggle|status]" >&2; exit 2 ;;
esac
