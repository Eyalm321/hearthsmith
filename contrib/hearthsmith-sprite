#!/usr/bin/env bash
# hearthsmith-sprite [start|stop|toggle|status|size <mult>|move <x> <y>|corner <name>|prompt <0..1>]
# The avatar runs as a user service; position/size live in ~/.config/hearthsmith/avatar.yaml and
# hot-reload, so every command here just edits that file.
set -euo pipefail
U=hearthsmith-sprite.service
CFG=~/.config/hearthsmith/avatar.yaml
patch() { /usr/bin/python3 - "$@" <<'EOF'
import sys, yaml, pathlib
p = pathlib.Path.home() / ".config/hearthsmith/avatar.yaml"
cfg = yaml.safe_load(p.read_text()) if p.exists() else {}
cfg = cfg or {}
for kv in sys.argv[1:]:
    k, v = kv.split("=", 1)
    if v == "__del__": cfg.pop(k, None); continue
    cfg[k] = yaml.safe_load(v)
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(yaml.safe_dump(cfg, sort_keys=True))
print({k: cfg.get(k) for k in ("scale", "x", "y", "corner", "sheet", "prompt_y")})
EOF
}
case "${1:-toggle}" in
  start)  systemctl --user start "$U" ;;
  stop)   systemctl --user stop "$U" ;;
  status) systemctl --user status "$U" --no-pager ;;
  toggle) if systemctl --user is-active -q "$U"; then systemctl --user stop "$U"; echo "sprite hidden"
          else systemctl --user start "$U"; echo "sprite shown"; fi ;;
  size)   patch "scale=${2:?size <multiplier, e.g. 1.5>}" ;;
  corner) patch "corner=${2:?corner top-left|top-right|bottom-left|bottom-right}" x=__del__ y=__del__ ;;
  prompt) patch "prompt_y=${2:?prompt <0..1 fraction of screen height, e.g. 0.22>}" ;;
  move)   patch "x=${2:?move <x> <y>}" "y=${3:?move <x> <y>}" corner=__del__ ;;
  *) sed -n 2,3p "$0" >&2; exit 2 ;;
esac
