[Unit]
Description=forge voice: warm Qwen3-TTS voice-clone server on 127.0.0.1:7861
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/forge-voice
ExecStart=%h/dev/forge-voice/.venv/bin/python %h/dev/forge/contrib/voice-server/server.py
Environment=PYTHONUNBUFFERED=1
Environment=FORGE_VOICE_IDLE=900
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
